{
  "name": "infomil-scrum-timer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mood:catalog": "powershell.exe -NoProfile -File scripts/create-remote-catalog.ps1",
    "assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets",
    "dev": "next dev",
    "prebuild": "npm run assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:check": "drizzle-kit check",
    "db:verify": "tsx scripts/check-database.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@next/env": "^16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
