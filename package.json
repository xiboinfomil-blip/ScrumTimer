{
  "name": "infomil-scrum-timer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/participants",
    "packages/*"
  ],
  "scripts": {
    "mood:catalog": "powershell.exe -NoProfile -File scripts/create-remote-catalog.ps1",
    "assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets",
    "dev": "next dev",
    "prebuild": "npm run assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:concurrency": "tsx scripts/test-live-concurrency.ts",
    "dev:participants": "npm run dev --workspace @infomil/scrum-participants -- --port 3002",
    "build:participants": "npm run build --workspace @infomil/scrum-participants",
    "start:participants": "npm run start --workspace @infomil/scrum-participants -- --port 3002",
    "lint:participants": "npm run lint --workspace @infomil/scrum-participants",
    "typecheck:participants": "npm run typecheck --workspace @infomil/scrum-participants",
    "test:participants": "npm run test --workspace @infomil/scrum-participants",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:verify": "tsx scripts/check-database.ts"
  },
  "dependencies": {
    "@infomil/scrum-shared": "1.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@redis/client": "^5.8.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "drizzle-orm": "^0.45.1",
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.3.8",
    "fflate": "^0.8.2",
    "framer-motion": "12.10.6",
    "lucide-react": "1.70.0",
    "next": "16.3.5",
    "oauth4webapi": "^3.8.8",
    "radix-ui": "1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "1.4.0"
  },
  "overrides": {
    "typescript-eslint": "8.71.1",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@typescript-eslint/project-service": "8.71.1",
    "@typescript-eslint/scope-manager": "8.71.1",
    "@typescript-eslint/tsconfig-utils": "8.71.1",
    "@typescript-eslint/type-utils": "8.71.1",
    "@typescript-eslint/types": "8.71.1",
    "@typescript-eslint/typescript-estree": "8.71.1",
    "@typescript-eslint/utils": "8.71.1",
    "@typescript-eslint/visitor-keys": "8.71.1",
    "framer-motion": {
      "motion-dom": "12.10.6",
      "motion-utils": "12.9.4"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@next/env": "^16.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
